# Zendesk MCP server — local configuration
# Copy this file to `.env` and fill in the shared service account details.
# `.env` is git-ignored; never commit real credentials.

# The account subdomain, e.g. "acme" for acme.zendesk.com
ZENDESK_SUBDOMAIN=yoursubdomain

# The agent e-mail address that actions are attributed to
ZENDESK_EMAIL=agent@yourcompany.com

# The account API token (created by an admin in Zendesk Admin Centre)
ZENDESK_API_TOKEN=your-api-token

# --- Optional ---

# Transport: "stdio" (default, for local/Claude Code) or "http" (for hosting)
# TRANSPORT=stdio

# Shared key for the HTTP transport in non-production (sent as the X-API-Key header).
# Not needed for stdio.
# MCP_API_KEY=choose-a-secret
